# Gemini API key is NOT set here — it lives only as a Supabase Edge Function
# secret (never in the client bundle). Deploy with:
#   supabase functions deploy gemini-proxy
#   supabase secrets set GEMINI_API_KEY=your_gemini_api_key_here

# Set to 'true' to force scripted/simulated AI responses instead of calling
# the real Gemini API (useful for demoing offline).
EXPO_PUBLIC_GEMINI_SIMULATION=false

# Supabase Project Credentials (obtain from https://supabase.com/dashboard)
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
